#!/bin/bash
# ---------------------------------------------------------------------------
# fnSoar amd64 panel daemon (fnOS service entry)
#
# fnOS launches bin/mihomo (architecture wrapper) as the app daemon. The
# engine is NOT started here anymore: this wrapper runs the admin panel
# server in the FOREGROUND so fnOS tracks THIS PID. The mihomo engine is a
# child process managed by the admin server according to service.state.
#
# Behavioral change (v1.0.68+):
#   - opening the app only brings up the panel; the engine starts only if the
#     last saved service state is ON (dedicated 'fnsoar' UID + nftables rules
#     for host-transparent mode are applied by bin/engine-start).
#   - stopping the service in the panel no longer kills the fnOS daemon, so
#     the desktop window stays open.
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_ROOT="$(dirname "$SCRIPT_DIR")"
ADMIN_SERVER="${APP_ROOT}/admin/admin_server.py"

# Path precedence mirrors admin_server.py: explicit MIHOMO_* vars first, then
# the fnOS-provided TRIM_* vars, then sane defaults.
DEST_DIR="${MIHOMO_DEST_DIR:-${TRIM_APPDEST:-${APP_ROOT}}}"
DATA_DIR="${MIHOMO_DATA_DIR:-${TRIM_PKGVAR:-/vol1/@appdata/fnnas.fnsoar}}"
export MIHOMO_APP_NAME="${MIHOMO_APP_NAME:-fnnas.fnsoar}"
export MIHOMO_DATA_DIR="${DATA_DIR}"
export MIHOMO_DEST_DIR="${DEST_DIR}"
export MIHOMO_ADMIN_PORT="${MIHOMO_ADMIN_PORT:-9099}"
export MIHOMO_CTRL_PORT="${MIHOMO_CTRL_PORT:-9090}"
export MIHOMO_GATEWAY_SOCK="${MIHOMO_GATEWAY_SOCK:-${DEST_DIR}/fnsoar.sock}"

[ -f "$ADMIN_SERVER" ] || { echo "admin server missing: $ADMIN_SERVER" >&2; exit 1; }
# fnOS passes "-d <dir>"; the admin server derives paths from env instead.
exec python3 "$ADMIN_SERVER" "$@"