# ── Build packages / archives (too large for git, regenerated by build) ──
*.fpk
*.fpk.bak
*.tgz
*.bak

# ── Compiled engine binaries (only the .real binaries; scripts stay in git) ──
resources/core/*/*.real

# ── Geo data (redownloaded / regenerated; not source) ──
fnpack/app/default-config/*
!fnpack/app/default-config/config.yaml

# ── Third-party dashboard bundles (dist build outputs) ──
frontend/dashboard/

# ── Build outputs & scratch (dist/ holds *.fpk, app.tgz and tmp_build/) ──
dist/

# ── Python ──
__pycache__/
*.pyc

# ── Agent harness local state ──
.mnemon/

# ── Tooling / transient ──
*.log

# ── 本地新增的图标文件（未定用途，暂不入库） ──
fnpack/icon*-512x512.png
